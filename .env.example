# SEO Engine environment reference — do not fill in every field.
# Ask your agent to run seo-setup; it selects integrations from your goals and
# writes only chosen settings to the workspace's ignored .env. No key is needed
# for host-agent writing, the human corpus, local inspection or basic crawling.
# Never commit real values or paste secrets into chat. The onboarding credential
# helper accepts hidden terminal input or a user-selected local credential file.
# Presence is not verified access: check only selected services before using them.
# Prices/entitlements change; check the selected account before authorizing spend.
# Workspace .env < process environment. No other workspace's .env is inherited.
# This is parsed as data, not shell code: no interpolation or `source .env`.

# SITE / PATHS (not secrets)
# Prefer site_url in .seo-engine/config.yml; this is an optional fallback.
SEO_SITE_URL=
# Set in the PROCESS environment for CI/scheduled commands or ambiguous cwd.
# These path overrides must not be put in .env: they are needed before loading it.
# SEO_REPO_ROOT=/absolute/website-workspace
# SEO_ENGINE_ROOT=/absolute/engine-copy   (only for copied, non-symlink skills)

# SEARCH CONSOLE + ANALYTICS — existing site performance and measurement.
# Obtain a Google service-account key and grant that account access to the site's
# Search Console / GA4 property. Enable the relevant APIs in its Cloud project.
# Use ONE credential form: absolute JSON file path, or compact inline JSON.
# Keep downloaded keys in ignored credentials/; never print their contents.
# Setup: https://console.cloud.google.com/iam-admin/serviceaccounts
# Property access: https://search.google.com/search-console and https://analytics.google.com/
GOOGLE_APPLICATION_CREDENTIALS=
GSC_SERVICE_ACCOUNT_JSON=
# Numeric GA4 property ID (not a G- measurement ID); also requires Google credentials
# and Viewer access. No GA4? Use an attributable export or record measurement unavailable.
GA4_PROPERTY_ID=

# PERFORMANCE — PSI Lighthouse, CrUX field/history data; optional for technical work.
# https://developers.google.com/speed/docs/insights/v5/get-started
GOOGLE_PSI_API_KEY=

# GOOGLE SERPS / DEMAND — choose relevant providers; not all three.
# DataForSEO API credentials (not your ordinary account password); BOTH required.
# https://app.dataforseo.com/ — paid usage. Useful for SERPs, volumes, keyword ideas.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
# https://app.ahrefs.com/ — API entitlement needed; keywords/backlinks/competitors.
AHREFS_API_KEY=
# https://developer.semrush.com/ — API entitlement/units needed; alternate SEO data.
SEMRUSH_API_KEY=

# WEB DISCOVERY / RENDERING — optional when host browsing is sufficient.
# https://api-dashboard.search.brave.com/ — web results, NOT Google rank/volume data.
BRAVE_SEARCH_API_KEY=
# https://www.firecrawl.dev/ — rendered scraping, crawling, mapping and search.
FIRECRAWL_API_KEY=

# INDEXING / BING — optional, does not guarantee indexing or Google submission.
# https://www.bing.com/webmasters/ — account API key for Bing reporting.
BING_WEBMASTER_API_KEY=
# Generated locally with seo-indexing/scripts/setup_indexnow_key.py; the matching
# verification file must ship on the actual website before submission.
INDEXNOW_API_KEY=

# SCRIPTED TEXT / AI VISIBILITY — separate from the model running your host agent.
# Host-written articles require no extra LLM key. Scripted pub-* text needs ONE of
# OpenAI, Anthropic or Gemini; set LLM_PROVIDER explicitly. Visibility probes use
# only the vendors you choose. API billing is separate from chat subscriptions.
# https://platform.openai.com/api-keys
OPENAI_API_KEY=
# https://console.anthropic.com/
ANTHROPIC_API_KEY=
# https://aistudio.google.com/apikey
GOOGLE_GEMINI_API_KEY=
# https://www.perplexity.ai/settings/api — visibility probing only, not pub text.
PERPLEXITY_API_KEY=
# openai | anthropic | gemini. Do not infer from the host agent's vendor.
LLM_PROVIDER=
# Optional model IDs available to the selected account; blank uses adapter defaults.
# Choose current supported models during setup and verify the chosen path.
LLM_MODEL_OPENAI=
LLM_CHEAP_MODEL_OPENAI=
LLM_MODEL_ANTHROPIC=
LLM_CHEAP_MODEL_ANTHROPIC=
LLM_MODEL_GEMINI=
LLM_CHEAP_MODEL_GEMINI=
# Optional provider/model-supported reasoning effort; leave blank unless needed.
LLM_EFFORT=

# IMAGES — optional scripted covers; reuses the selected provider's key above.
# openai | gemini. Without an image API, the pipeline can use SVG fallback.
IMAGE_PROVIDER=
IMAGE_MODEL_OPENAI=
IMAGE_MODEL_GEMINI=

# OPTIONAL EDITORIAL SOURCES — only if part of the chosen publication workflow.
# https://sociavault.com/ — social conversation research, paid API usage.
SOCIAVAULT_API_KEY=
# https://github.com/settings/tokens — selected GitHub research sources; minimal scope.
GITHUB_TOKEN=
# https://www.notion.so/profile/integrations — selected explicitly shared Notion sources.
NOTION_TOKEN=

# OPTIONAL AI VISIBILITY DASHBOARDS — existing accounts, not prerequisites.
# https://www.tryprofound.com/ — API access depends on account entitlement.
PROFOUND_API_KEY=
# https://otterly.ai/ — API key; project ID selects the project for reporting.
OTTERLY_API_KEY=
OTTERLY_PROJECT_ID=

# PROOFREADING — owned LanguageTool server OR authenticated API entitlement.
# https://languagetool.org/http-api/ — public endpoint is not for automated workloads.
# Full /v2/check URL. Owned server may need no auth; paid API needs BOTH below.
LANGUAGETOOL_URL=
LANGUAGETOOL_USERNAME=
LANGUAGETOOL_API_KEY=
# Optional behavior; these are not credentials. Match the publication's language.
LANGUAGETOOL_LANGUAGE=en-US
LANGUAGETOOL_LEVEL=default
# Comma-separated language variants when using automatic language detection.
LANGUAGETOOL_PREFERRED_VARIANTS=
# Comma-separated rule IDs to disable only for an established editorial reason.
LANGUAGETOOL_DISABLED_RULES=
# Request chunk size (characters); adjust only for actual service limits.
LANGUAGETOOL_CHUNK_CHARS=10000
