# seo-engine environment configuration
#
# Copy this file to .env at the ROOT of the target website repo (the same
# level you copied the seo-engine/ folder into) and fill in only the keys
# you have. Every integration in this system is OPTIONAL — seo-engine works
# with zero keys using the built-in crawler plus Google's free APIs. Each
# skill's SKILL.md states exactly what unlocks with which key below.
#
# NEVER commit a real .env file. This .env.example is the only one meant to
# be committed — it contains placeholders only.

# -----------------------------------------------------------------------------
# Required (soft): the site this instance manages
# -----------------------------------------------------------------------------
# Fallback if .seo-engine/config.yml (written by the seo-setup skill) doesn't
# set site_url. Prefer letting seo-setup write config.yml over setting this.
SEO_SITE_URL=

# -----------------------------------------------------------------------------
# Google Search Console API — free, no usage cap beyond generous per-project
# quotas. Powers: search performance data, URL Inspection (index status,
# selected canonical, rich-results verdict), sitemap submission.
# Auth is OAuth2 via a service account — no simple API key exists for this API.
# Setup: create a GCP service account, download its JSON key, then in Search
# Console (Settings > Users and permissions) add the service account's
# client_email as a verified Owner/User on your already-verified property.
# See references/api-reference.md for the full walkthrough.
# -----------------------------------------------------------------------------
# Path to the downloaded service-account JSON key file (preferred).
GOOGLE_APPLICATION_CREDENTIALS=
# OR paste the JSON inline (useful where mounting a file isn't convenient,
# e.g. some CI/serverless environments). Set only ONE of these two.
GSC_SERVICE_ACCOUNT_JSON=

# -----------------------------------------------------------------------------
# Google PageSpeed Insights v5 + Chrome UX Report (CrUX) API — free.
# One key powers both. Optional but recommended (unlocks higher quota vs.
# the unauthenticated tier). Get one at:
# https://developers.google.com/speed/docs/insights/v5/get-started
# -----------------------------------------------------------------------------
GOOGLE_PSI_API_KEY=

# -----------------------------------------------------------------------------
# Ahrefs API v3 — paid, available from the Lite plan and up.
# Powers: domain rating, backlinks, organic keywords, competitor overlap.
# Create a key in Ahrefs > Account Settings > API Keys (owner/admin only).
# -----------------------------------------------------------------------------
AHREFS_API_KEY=

# -----------------------------------------------------------------------------
# DataForSEO — paid, pay-as-you-go, no subscription tier gate, $50 minimum
# deposit. Cheaper/more open alternative to Ahrefs/Semrush for SERP tracking,
# keyword volume, backlinks, and on-page crawl audits.
# Create dedicated API credentials in the DataForSEO dashboard (distinct
# from your account login password).
# -----------------------------------------------------------------------------
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# -----------------------------------------------------------------------------
# Semrush API — paid, requires a Business-plan (SEO Toolkit) subscription
# plus a separately-purchased API-unit balance. Powers: domain overview,
# organic keywords, backlinks, Site Audit (via the newer Projects API).
# -----------------------------------------------------------------------------
SEMRUSH_API_KEY=

# -----------------------------------------------------------------------------
# Bing Webmaster Tools API — free. Note: this API is de facto frozen
# (docs last substantively updated ~2022) — used here only for crawl-stats/
# query-stats reads. For URL submission, use IndexNow below instead.
# Get a key from the Bing Webmaster Tools dashboard (bing.com/webmasters).
# -----------------------------------------------------------------------------
BING_WEBMASTER_API_KEY=

# -----------------------------------------------------------------------------
# IndexNow — free. Notifies Bing, Yandex, Naver, Seznam.cz, Yep, and Amazon
# of changed URLs (Google and Baidu do NOT participate — for Google, rely on
# Search Console instead). Generate a key with:
#   python3 -c "from scripts.lib import indexnow; print(indexnow.generate_key())"
# then host it via seo-indexing's setup_indexnow_key.py script.
# -----------------------------------------------------------------------------
INDEXNOW_API_KEY=

# -----------------------------------------------------------------------------
# Firecrawl — paid (free tier: 1,000 credits/month), JS-rendering scrape/
# crawl API. Used to diff raw HTML vs. rendered content and catch
# JS-hydration content invisible to naive crawlers. Get a key at firecrawl.dev
# (limited use works without one, but rate limits are tight).
# -----------------------------------------------------------------------------
FIRECRAWL_API_KEY=

# Optional independent web discovery (not Google rankings). Key from
# https://api-dashboard.search.brave.com; subscription/quota required.
BRAVE_SEARCH_API_KEY=

# -----------------------------------------------------------------------------
# LLM provider APIs — two uses:
#   1. geo-monitor's DIY AI-citation probing and brand-mention tracking
#      (each vendor's own web-search/grounding tool, checking whether your
#      domain is cited / your brand is named).
#   2. The pub-* publication skills' bring-your-own-key content pipeline
#      (research synthesis, drafting, judging, enhance, seers). Any ONE of
#      Anthropic / OpenAI / Gemini is enough; Perplexity is probing-only.
# Each key is independently optional.
# -----------------------------------------------------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
PERPLEXITY_API_KEY=
GOOGLE_GEMINI_API_KEY=

# Optional overrides for the pub-* content pipeline (defaults live in
# scripts/lib/llm.py and are listed in api-reference.md). LLM_PROVIDER picks
# which configured provider to prefer (anthropic | openai | gemini); the
# model variables pin ids when a vendor deprecates one; LLM_EFFORT
# (low | medium | high) applies to Anthropic models that support it.
LLM_PROVIDER=
LLM_MODEL_ANTHROPIC=
LLM_CHEAP_MODEL_ANTHROPIC=
LLM_MODEL_OPENAI=
LLM_CHEAP_MODEL_OPENAI=
LLM_MODEL_GEMINI=
LLM_CHEAP_MODEL_GEMINI=
LLM_EFFORT=

# -----------------------------------------------------------------------------
# Cover images (pub-visuals gen_cover.py) — uses OPENAI_API_KEY (gpt-image)
# or GOOGLE_GEMINI_API_KEY (Gemini image model) from above. With neither, a
# deterministic SVG cover is rendered instead. IMAGE_PROVIDER picks when both
# keys exist (openai | gemini); the model variables pin ids.
# -----------------------------------------------------------------------------
IMAGE_PROVIDER=
IMAGE_MODEL_OPENAI=
IMAGE_MODEL_GEMINI=

# -----------------------------------------------------------------------------
# SociaVault — paid (credit packs, 1 credit per request), social-media
# scraping API: Reddit, X, TikTok, YouTube, Instagram search. Used by
# pub-curate for the "social conversations" topic signal and the social_trend
# seer — read-only listening, never posting. Get a key at sociavault.com.
# -----------------------------------------------------------------------------
SOCIAVAULT_API_KEY=

# -----------------------------------------------------------------------------
# Seer sources (pub-curate seers.py) — both optional.
# GITHUB_TOKEN: lifts the GitHub REST API from 60 to 5,000 requests/hour for
#   the github_release / github_pr seers (public repos; read-only).
# NOTION_TOKEN: an internal-integration token; the notion_activity seer polls
#   pages shared with that integration for "something changed" triggers.
# -----------------------------------------------------------------------------
GITHUB_TOKEN=
NOTION_TOKEN=

# -----------------------------------------------------------------------------
# Commercial AI-visibility trackers — optional, supplementary cross-checks
# to the DIY probing above. Of the whole category, these two are the only
# ones with real, documented, self-serve-ish APIs as of this research.
# -----------------------------------------------------------------------------
# Profound (tryprofound.com) — API in beta. Starter plan $99/mo+.
PROFOUND_API_KEY=

# Otterly.AI (otterly.ai) — API requires Standard tier ($189/mo) or above.
OTTERLY_API_KEY=
OTTERLY_PROJECT_ID=

# Optional GA4 actual referral traffic; same service account needs GA4 Viewer access.
GA4_PROPERTY_ID=

# LanguageTool: configure an owned server or authenticated proofreading API.
# Public api.languagetool.org forbids automated calls and is rejected.
# Local: http://127.0.0.1:8081/v2/check
# Hosted: https://api.languagetoolplus.com/v2/check (username + API token required)
LANGUAGETOOL_URL=
LANGUAGETOOL_USERNAME=
LANGUAGETOOL_API_KEY=
LANGUAGETOOL_LANGUAGE=en-US
LANGUAGETOOL_LEVEL=default
# Required when language=auto; e.g. en-US,de-DE
LANGUAGETOOL_PREFERRED_VARIANTS=
# Comma-separated rule IDs, only for documented brand/editorial exceptions.
LANGUAGETOOL_DISABLED_RULES=
LANGUAGETOOL_CHUNK_CHARS=10000
